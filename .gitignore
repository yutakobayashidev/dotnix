# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore pre-commit config generated by git-hooks.nix
.pre-commit-config.yaml

# Ignore MCP config generated by mcp-servers-nix
.mcp.json

# Swap files
*.swp

# AI agent working files
z-ai/
.sofa/
.worktrees/
sgconfig.yml

# Terraform state
*.tfstate
*.tfstate.*
.terraform/
crash.log
override.tf
override.tf.json
terraform.rc
abcde.*/

# Terraform tfvars (local secrets)
infra/uptime-kuma/*.tfvars
infra/oci/nix-builder/*.tfvars
infra/oci/nix-builder/oci_secrets.yaml

# Generated agent skill deployments
**/.agent/skills/
**/.agents/skills/
**/.claude/skills/
**/.codex/skills/
**/.cursor/skills/
**/.gemini/skills/
