			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "green"
					},
					"decimals": 0
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"colorMode": "value",
				"graphMode": "none",
				"textMode": "value",
				"justifyMode": "center",
				"orientation": "auto",
				"wideLayout": true,
				"showPercentChange": false
			}
		},
