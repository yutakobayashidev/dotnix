{
	"title": "Android",
	"uid": "activitylog-android",
	"description": "Phone usage from the activitylog Android app: screen time, apps, mobile data, browser tabs, unlocks and location.",
	"tags": ["activitylog", "android", "opentelemetry"],
	"timezone": "browser",
	"editable": true,
	"graphTooltip": 1,
	"schemaVersion": 39,
	"time": {
		"from": "now-24h",
		"to": "now"
	},
	"refresh": "5m",
	"links": [
		{
			"title": "activitylog",
			"type": "dashboards",
			"tags": ["activitylog"],
			"asDropdown": true,
			"icon": "external link",
			"includeVars": false,
			"keepTime": true
		}
	],
	"templating": {
		"list": [
			{
				"name": "prom",
				"label": "Metrics",
				"type": "datasource",
				"query": "prometheus",
				"current": {
					"text": "Prometheus",
					"value": "PBFA97CFB590B2093"
				},
				"hide": 2,
				"includeAll": false,
				"multi": false,
				"options": [],
				"refresh": 1,
				"regex": "/.*/",
				"skipUrlSync": false
			},
			{
				"name": "loki",
				"label": "Logs",
				"type": "datasource",
				"query": "loki",
				"current": {
					"text": "Loki",
					"value": "loki"
				},
				"hide": 2,
				"includeAll": false,
				"multi": false,
				"options": [],
				"refresh": 1,
				"regex": "/.*/",
				"skipUrlSync": false
			},
			{
				"name": "tempo",
				"label": "Traces",
				"type": "datasource",
				"query": "tempo",
				"current": {
					"text": "Tempo",
					"value": "tempo"
				},
				"hide": 2,
				"includeAll": false,
				"multi": false,
				"options": [],
				"refresh": 1,
				"regex": "/.*/",
				"skipUrlSync": false
			},
			{
				"name": "device",
				"label": "Device",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "${prom}"
				},
				"query": "label_values(activity_time_seconds_total{job=\"activitylog/activitylog-android\"}, instance)",
				"definition": "label_values(activity_time_seconds_total{job=\"activitylog/activitylog-android\"}, instance)",
				"current": {},
				"hide": 0,
				"includeAll": true,
				"multi": false,
				"options": [],
				"refresh": 2,
				"regex": "",
				"skipUrlSync": false,
				"sort": 1,
				"description": "Select one Android device, or All for the combined daily report.",
				"allValue": ".*"
			}
		]
	},
	"annotations": {
		"list": [
			{
				"builtIn": 1,
				"datasource": {
					"type": "grafana",
					"uid": "-- Grafana --"
				},
				"enable": true,
				"hide": true,
				"iconColor": "rgba(0, 211, 255, 1)",
				"name": "Annotations & Alerts",
				"type": "dashboard"
			}
		]
	},
	"panels": [
		{
			"type": "row",
			"title": "Overview ($device)",
			"id": 1,
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"type": "stat",
			"title": "Screen time",
			"description": "Time the device was in use (screen on and unlocked) in the selected range. Shows the selected device; All combines devices.",
			"id": 2,
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 3,
				"h": 4
			},
			"datasource": {
				"type": "prometheus",
				"uid": "${prom}"
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${prom}"
					},
					"refId": "A",
					"editorMode": "code",
					"expr": "sum(increase(activity_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\", activity_state=\"active\"}[$__range]))",
					"legendFormat": "__auto",
					"range": false,
					"instant": true
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"color": {
						"mode": "fixed",
						"fixedColor": "blue"
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"colorMode": "value",
				"graphMode": "none",
				"textMode": "value",
				"justifyMode": "center",
				"orientation": "auto",
				"wideLayout": true,
				"showPercentChange": false
			}
		},
		{
			"type": "stat",
			"title": "Unlocks",
			"description": "Number of device unlocks in the selected range. Shows the selected device; All combines devices.",
			"id": 3,
			"gridPos": {
				"x": 3,
				"y": 1,
				"w": 3,
				"h": 4
			},
			"datasource": {
				"type": "prometheus",
				"uid": "${prom}"
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${prom}"
					},
					"refId": "A",
					"editorMode": "code",
					"expr": "sum(increase(activity_device_unlocks_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__range]))",
					"legendFormat": "__auto",
					"range": false,
					"instant": true
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "purple"
					},
					"decimals": 0
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"colorMode": "value",
				"graphMode": "none",
				"textMode": "value",
				"justifyMode": "center",
				"orientation": "auto",
				"wideLayout": true,
				"showPercentChange": false
			}
		},
		{
			"type": "stat",
			"title": "Time per unlock",
			"description": "Average screen time per unlock. Shows the selected device; All combines devices.",
			"id": 4,
			"gridPos": {
				"x": 6,
				"y": 1,
				"w": 3,
				"h": 4
			},
			"datasource": {
				"type": "prometheus",
				"uid": "${prom}"
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${prom}"
					},
					"refId": "A",
					"editorMode": "code",
					"expr": "sum(increase(activity_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\", activity_state=\"active\"}[$__range])) / sum(increase(activity_device_unlocks_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__range]))",
					"legendFormat": "__auto",
					"range": false,
					"instant": true
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"color": {
						"mode": "fixed",
						"fixedColor": "blue"
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"colorMode": "value",
				"graphMode": "none",
				"textMode": "value",
				"justifyMode": "center",
				"orientation": "auto",
				"wideLayout": true,
				"showPercentChange": false
			}
		},
		{
			"type": "stat",
			"title": "Apps used",
			"description": "Number of apps that were in the foreground for at least a minute. Shows the selected device; All combines devices.",
			"id": 5,
			"gridPos": {
				"x": 9,
				"y": 1,
				"w": 3,
				"h": 4
			},
			"datasource": {
				"type": "prometheus",
				"uid": "${prom}"
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${prom}"
