						"uid": "loki"
					},
					"queryType": "range",
					"legendFormat": "アカウント {{account_number}} / {{window_minutes}} 分枠",
					"editorMode": "code"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"noValue": "不明",
					"decimals": 1,
					"color": {
						"mode": "palette-classic"
					},
					"min": 0,
					"max": 100
