		{
			"id": 5,
			"title": "アカウント別の残量",
			"type": "timeseries",
			"description": "プラン間の%は利用可能トークン数の比較ではありません。",
			"gridPos": {
				"x": 0,
				"y": 7,
				"w": 14,
				"h": 8
			},
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "(last_over_time({job=\"codex-usage-advisor\"} | json | event=\"usage_snapshot\" | remaining_percent!=\"\"  | unwrap remaining_percent | __error__=\"\" [15m]) by (host, account, account_number, window_minutes)) and on (host, account) (last_over_time({job=\"codex-usage-advisor\"} | json | event=\"account_status\" | fresh!=\"\"  | unwrap fresh | __error__=\"\" [15m]) by (host, account, account_number) == 1)",
					"datasource": {
						"type": "loki",
						"uid": "loki"
					},
					"queryType": "range",
					"legendFormat": "アカウント {{account_number}} / {{window_minutes}} 分枠",
					"editorMode": "code"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"noValue": "不明",
					"decimals": 1,
					"color": {
						"mode": "palette-classic"
					},
					"min": 0,
					"max": 100
				},
				"overrides": []
			},
