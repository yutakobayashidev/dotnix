			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"expr": "(last_over_time({job=\"codex-usage-advisor\"} | json | event=\"usage_snapshot\" | remaining_percent!=\"\"  | unwrap remaining_percent | __error__=\"\" [15m]) by (host, account, account_number, window_minutes)) and on (host, account) (last_over_time({job=\"codex-usage-advisor\"} | json | event=\"account_status\" | fresh!=\"\"  | unwrap fresh | __error__=\"\" [15m]) by (host, account, account_number) == 1)",
