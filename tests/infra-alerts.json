				{
					"series": "smartctl_device_attribute{job=\"smartctl\",instance=\"localhost:9633\",host=\"server\",device=\"sda\",attribute_id=\"197\",attribute_name=\"Current_Pending_Sector\",attribute_value_type=\"raw\"}",
					"values": "1+0x35"
				},
				{
					"series": "smartctl_device_attribute{job=\"smartctl\",instance=\"localhost:9633\",host=\"server\",device=\"sdb\",attribute_id=\"197\",attribute_name=\"Current_Pending_Sector\",attribute_value_type=\"value\"}",
					"values": "100+0x35"
				},
				{
					"series": "smartctl_device_attribute{job=\"smartctl\",instance=\"localhost:9633\",host=\"server\",device=\"sdc\",attribute_id=\"197\",attribute_name=\"Current_Pending_Sector\",attribute_value_type=\"raw\"}",
					"values": "0+0x35"
				},
				{
					"series": "smartctl_device_attribute{job=\"smartctl\",instance=\"localhost:9633\",host=\"server\",device=\"sdd\",attribute_id=\"9\",attribute_name=\"Current_Pending_Sector\",attribute_value_type=\"raw\"}",
					"values": "10000+0x35"
				}
			],
			"alert_rule_test": [
				{
					"eval_time": "14m",
					"alertname": "DiskBadSectors",
					"exp_alerts": []
				},
				{
					"eval_time": "16m",
					"alertname": "DiskBadSectors",
					"exp_alerts": [
						{
							"exp_labels": {
								"job": "smartctl",
								"instance": "localhost:9633",
								"host": "server",
								"device": "sda",
								"attribute_id": "197",
								"attribute_name": "Current_Pending_Sector",
								"attribute_value_type": "raw",
								"category": "infra",
								"severity": "warning"
							},
							"exp_annotations": {
								"summary": "server sda: Current_Pending_Sector is non-zero",
								"dashboard_url": "https://grafana.home.yutakobayashi.com/d/dotnix-hardware-overview"
							}
						}
					]
				}
			]
		},
