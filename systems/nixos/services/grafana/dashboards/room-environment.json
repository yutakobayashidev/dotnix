  "uid": "dotnix-room-environment",
  "title": "Room Environment",
  "description": "Home Assistant metrics stored in VictoriaMetrics. Entity choices come from collected metrics. No data can mean an unavailable device or a different metric/unit; inspect Home Assistant exports before configuring alerts. This overview may include non-room sensors; select the intended entities.",
  "tags": [
    "dotnix",
    "home-assistant",
    "room"
  ],
  "templating": {
    "list": [
      {
        "name": "entity",
        "label": "Entity",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values({__name__=~\"homeassistant_sensor_.*\"}, entity)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"homeassistant_sensor_.*\"}, entity)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "climate",
        "label": "Air conditioner",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(homeassistant_climate_current_temperature_celsius, entity)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(homeassistant_climate_current_temperature_celsius, entity)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
