{
	"uid": "codex-telemetry",
	"title": "Codex telemetry",
	"description": "Native Codex OTLP metrics, logs and traces. Overview/activity layout follows natsukium Claude dashboard, using actual Codex metric names. No billing cost is inferred. Counter increases require multiple samples and can undercount short sessions. Hosts are not offered without a verified host attribute.",
	"tags": ["coding-agents", "codex"],
	"schemaVersion": 39,
	"version": 1,
	"refresh": "30s",
	"time": {
		"from": "now-6h",
		"to": "now"
	},
	"timezone": "browser",
	"panels": [
		{
			"id": 1,
			"title": "Total tokens",
			"type": "stat",
			"datasource": {
				"type": "prometheus",
				"uid": "PBFA97CFB590B2093"
			},
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 4,
				"h": 4
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "palette-classic"
					}
				},
				"overrides": []
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum(increase(codex_turn_token_usage_sum{model=~\"$model\",token_type=\"total\"}[$__range]))",
					"datasource": {
						"type": "prometheus",
						"uid": "PBFA97CFB590B2093"
					},
					"legendFormat": "{{model}}",
					"instant": true,
					"range": false
				}
			],
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				}
			}
		},
