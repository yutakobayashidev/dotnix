		{
			"id": 15,
			"title": "Recent Codex traces",
			"type": "table",
			"datasource": {
				"type": "tempo",
				"uid": "tempo"
			},
			"gridPos": {
				"x": 0,
				"y": 36,
				"w": 24,
				"h": 10
			},
			"options": {
				"showHeader": true
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "tempo",
						"uid": "tempo"
					},
					"queryType": "traceql",
					"query": "{ resource.service.name =~ \"codex.*\" }",
					"tableType": "traces",
					"limit": 50
				}
			],
			"description": "All Codex models; model attributes are not guaranteed on every span. Follow a trace to matching Loki events."
		}
	],
	"templating": {
		"list": [
			{
				"name": "model",
				"label": "Model",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "PBFA97CFB590B2093"
				},
				"definition": "label_values(codex_turn_token_usage_sum, model)",
				"query": {
					"query": "label_values(codex_turn_token_usage_sum, model)",
					"refId": "model-variable"
				},
				"includeAll": true,
				"multi": true,
				"allValue": ".*",
				"current": {
					"text": "All",
					"value": "$__all"
				},
				"refresh": 2,
				"sort": 1
			}
		]
	},
	"annotations": {
		"list": []
	}
}
