						"mode": "palette-classic"
					}
				},
				"overrides": []
			},
			"targets": [
				{
					"refId": "A",
					"expr": "sum by (model, token_type) (rate(codex_turn_token_usage_sum{model=~\"$model\",token_type!=\"total\"}[$__rate_interval]))",
					"datasource": {
						"type": "prometheus",
						"uid": "PBFA97CFB590B2093"
					},
					"legendFormat": "{{model}} {{token_type}}"
				}
			],
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"description": "Cached input is part of input; reasoning output is part of output. Do not sum these overlapping types."
		},
		{
			"id": 8,
			"title": "Turn duration p95",
			"type": "timeseries",
			"datasource": {
				"type": "prometheus",
				"uid": "PBFA97CFB590B2093"
			},
			"gridPos": {
				"x": 12,
