					"refId": "A",
					"expr": "{service_name=~\"codex.*\"} | model =~ \"$model\"",
					"datasource": {
						"type": "loki",
						"uid": "loki"
					}
				}
			],
			"options": {
				"showTime": true,
				"showLabels": false,
				"enableLogDetails": true,
				"sortOrder": "Descending"
			}
		},
		{
			"id": 14,
			"title": "Failed Codex events",
			"type": "logs",
			"datasource": {
