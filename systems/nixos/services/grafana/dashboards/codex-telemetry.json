			},
			"targets": [
				{
					"refId": "A",
					"expr": "{service_name=~\"codex.*\"} | model =~ \"$model\" | success = \"false\" or error != \"\"",
					"datasource": {
						"type": "loki",
						"uid": "loki"
					}
