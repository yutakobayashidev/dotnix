    {
      "id": 9,
      "title": "Firing hardware alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "ALERTS{alertstate=\"firing\",host=~\"$host\",alertname=~\"Hardware.*|Smart.*|DiskSmart.*|DiskWearout.*|DiskSpare.*|DiskMedia.*|DiskTemperature.*|Gpu.*\"}",
