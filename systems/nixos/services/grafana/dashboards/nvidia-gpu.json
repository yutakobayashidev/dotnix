	"panels": [
		{
			"type": "timeseries",
			"title": "Utilization",
			"description": "GPU compute and memory-controller utilization.",
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 0
			},
			"id": 1,
			"datasource": {
				"type": "prometheus",
				"uid": "PBFA97CFB590B2093"
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "PBFA97CFB590B2093"
					},
					"editorMode": "code",
					"expr": "100 * nvidia_smi_utilization_gpu_ratio{host=~\"$host\",uuid=~\"$uuid\"}",
					"legendFormat": "{{host}} {{uuid}} compute",
					"range": true
				},
				{
					"refId": "B",
					"datasource": {
						"type": "prometheus",
						"uid": "PBFA97CFB590B2093"
					},
					"editorMode": "code",
					"expr": "100 * nvidia_smi_utilization_memory_ratio{host=~\"$host\",uuid=~\"$uuid\"}",
					"legendFormat": "{{host}} {{uuid}} memory bandwidth",
					"range": true
				}
			],
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"fieldConfig": {
				"defaults": {
					"min": 0,
					"max": 100,
					"unit": "percent",
					"custom": {
						"drawStyle": "line",
						"lineInterpolation": "smooth",
						"lineWidth": 1,
						"fillOpacity": 15,
						"showPoints": "never",
						"spanNulls": false
					},
					"color": {
						"mode": "palette-classic"
					},
					"noValue": "No data"
				},
				"overrides": []
			}
		},
