+package store
+
+import (
+	"context"
+	"testing"
+
+	"github.com/nlewo/comin/internal/broker"
+	"github.com/nlewo/comin/pkg/protobuf"
+	"github.com/stretchr/testify/require"
+)
+
+// A replacement is registered before Builder.Eval cancels the old work.
+// Finishing that work must not collect the replacement before evaluation starts.
+func TestPendingGenerationSurvivesCancellation(t *testing.T) {
+	for _, phase := range []string{"evaluation", "build"} {
+		t.Run(phase, func(t *testing.T) {
+			tmp := t.TempDir()
+			bk := broker.New()
+			bk.Start()
+			t.Cleanup(bk.Stop)
+			s, err := New(bk, tmp+"/state", tmp+"/gcroot", 2, 2, 5)
+			require.NoError(t, err)
+			newGeneration := func() protobuf.Generation {
+				return s.NewGeneration("host", "", "system", &protobuf.GitRepositoryStatus{}, 0)
+			}
+			old := newGeneration()
+			require.NoError(t, s.GenerationEvalStarted(old.Uuid))
+			if phase == "build" {
+				require.NoError(t, s.GenerationEvalFinished(old.Uuid, "drv", "out", "machine", nil))
+				require.NoError(t, s.GenerationBuildStart(old.Uuid, "test"))
+			}
+			pending := newGeneration()
+			if phase == "evaluation" {
+				require.NoError(t, s.GenerationEvalFinished(old.Uuid, "", "", "", context.Canceled))
+			} else {
+				require.NoError(t, s.GenerationBuildFinished(old.Uuid, context.Canceled))
+			}
+			got, err := s.GenerationGet(pending.Uuid)
+			require.NoError(t, err)
+			require.Equal(t, EvalInit.String(), got.EvalStatus)
+			require.NoError(t, s.GenerationEvalStarted(pending.Uuid))
+			require.NoError(t, s.GenerationEvalFinished(pending.Uuid, "drv", "out", "machine", nil))
+			require.NoError(t, s.GenerationBuildStart(pending.Uuid, "test"))
+			require.NoError(t, s.GenerationBuildFinished(pending.Uuid, context.Canceled))
+
+			// Protection expires after evaluation starts, so normal GC still applies.
+			latest := newGeneration()
+			require.NoError(t, s.GenerationEvalStarted(latest.Uuid))
+			require.NoError(t, s.GenerationEvalFinished(latest.Uuid, "drv", "out", "machine", nil))
+			require.NoError(t, s.GenerationBuildStart(latest.Uuid, "test"))
+			require.NoError(t, s.GenerationBuildFinished(latest.Uuid, context.Canceled))
+			_, err = s.GenerationGet(pending.Uuid)
+			require.Error(t, err)
+		})
+	}
+}
