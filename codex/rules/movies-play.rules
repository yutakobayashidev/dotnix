# Allow external movie playback through the CLI.
prefix_rule(
    pattern = ["course-cli", "movies", "play", "--external"],
    decision = "allow",
    justification = "Do you want to allow external video playback? This needs mpv/GUI access outside the sandbox.",
    match = [
        "course-cli movies play --external 2478 31742 44234",
        "course-cli movies play --external 2478 31742 44235",
    ],
    not_match = [
        "course-cli movies play 2478 31742 44234 --no-play",
    ],
)
